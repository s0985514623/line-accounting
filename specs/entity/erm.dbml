// LINE 記帳 — 資料模型
// 單一使用者系統：白名單 LINE userId 由環境變數 LINE_OWNER_USER_ID 設定，不建 users 表。
// 部署於共用 PostgreSQL server，本應用使用獨立 database 與 user。

Enum ledger {
  personal [note: '個人']
  company  [note: '公司']
}

Enum entry_type {
  expense [note: '支出']
  income  [note: '收入']
}

Enum entry_source {
  line_text [note: 'LINE 文字訊息記帳（含選擇分類按鈕完成）']
  liff_form [note: 'LIFF 表單記帳']
}

Table categories {
  id          integer    [pk, increment]
  ledger      ledger     [not null]
  entry_type  entry_type [not null]
  name        varchar(50) [not null]
  is_fallback boolean    [not null, default: false, note: '「其他」分類；每個 ledger × entry_type 恰有一個，不可刪除']
  created_at  timestamp  [not null, default: `now()`]

  indexes {
    (ledger, entry_type, name) [unique]
  }

  Note: '''
  分類。個人/公司帳本各自一套，支出/收入分開。
  首次加好友時建立預設分類（各組都含「其他」，is_fallback = true）。
  刪除分類時：該分類的記帳紀錄改歸同 ledger × entry_type 的「其他」，關鍵字一併刪除。
  '''
}

Table category_keywords {
  id          integer    [pk, increment]
  category_id integer    [not null, ref: > categories.id]
  ledger      ledger     [not null, note: '冗餘自 category，用於唯一約束']
  entry_type  entry_type [not null, note: '冗餘自 category，用於唯一約束']
  keyword     varchar(50) [not null]
  created_at  timestamp  [not null, default: `now()`]

  indexes {
    (ledger, entry_type, keyword) [unique]
  }

  Note: '''
  自動學習的分類關鍵字。文字記帳對應不到分類、記帳者以按鈕選分類後，
  將「項目」詞記為該分類的關鍵字。比對時分類名稱優先於關鍵字。
  刪除分類時 ON DELETE CASCADE。
  '''
}

Table transactions {
  id          integer      [pk, increment]
  ledger      ledger       [not null]
  entry_type  entry_type   [not null]
  item        varchar(50)  [not null, note: '項目，例如「午餐」']
  amount      integer      [not null, note: 'must be > 0；TWD 正整數']
  category_id integer      [not null, ref: > categories.id]
  occurred_on date         [not null, note: '記帳日期（Asia/Taipei）']
  note        text         [null, note: '備註，選填']
  source      entry_source [not null]
  created_at  timestamp    [not null, default: `now()`]
  updated_at  timestamp    [not null, default: `now()`]

  indexes {
    (ledger, occurred_on)
    category_id
  }

  Note: '''
  記帳紀錄。category 必須與本筆的 ledger、entry_type 一致（應用層驗證）。
  刪除為硬刪除。
  '''
}

Table postback_tokens {
  token          varchar(64) [pk, note: '分類按鈕 postback data 內的唯一 id']
  transaction_id integer     [null, ref: > transactions.id]
  used_at        timestamp   [not null, default: `now()`]

  Note: '''
  防止重複點擊分類按鈕造成重複記帳。草稿內容本身放在 postback data（無狀態），
  此表只記錄已使用的 token。對應紀錄被刪除時 ON DELETE SET NULL（token 仍視為已使用）。
  '''
}

Table pending_entries {
  id          integer     [pk, increment]
  batch_id    varchar(64) [not null, note: '同一則 LINE 批次訊息共用']
  seq         integer     [not null, note: '原訊息行號，決定詢問分類的順序']
  ledger      ledger      [not null]
  entry_type  entry_type  [not null]
  item        varchar(50) [not null]
  amount      integer     [not null, note: 'CHECK amount > 0']
  occurred_on date        [not null]
  note        text        [null]
  created_at  timestamp   [not null, default: `now()`]

  indexes {
    (batch_id, seq)
    created_at
  }

  Note: '''
  LINE 多行批次記帳中對應不到分類的項目。依 seq 逐筆以分類按鈕（action=bpick&id=）詢問，
  選定後刪除本列並寫入 transactions。保留 7 天，逾期於下次批次記帳時清除。
  '''
}

Enum recurring_occurrence_status {
  pending   [note: '待確認']
  confirmed [note: '已入帳']
  skipped   [note: '已略過']
}

Table recurring_entries {
  id           integer     [pk, increment]
  ledger       ledger      [not null]
  entry_type   entry_type  [not null]
  item         varchar(50) [not null]
  amount       integer     [not null, note: 'CHECK amount > 0；預設金額，確認時可調整']
  category_id  integer     [not null, ref: > categories.id]
  day_of_month integer     [not null, note: 'CHECK 1–31；當月沒有該日 → 當月最後一天']
  note         text        [null]
  active       boolean     [not null, default: true]
  next_due_on  date        [not null, note: '下一次到期日（Asia/Taipei）']
  created_at   timestamp   [not null, default: `now()`]
  updated_at   timestamp   [not null, default: `now()`]

  indexes {
    (active, next_due_on)
  }

  Note: '''
  每月固定收支規則。排程（每 15 分鐘）將 next_due_on ≤ 今天的規則逐月產生 recurring_occurrences 並推進 next_due_on；
  Asia/Taipei 9 點後以 LINE push 通知（確認入帳 / 修改金額 / 略過）。分類被刪除時改歸同帳本同收支「其他」。
  '''
}

Table recurring_occurrences {
  id                 integer                     [pk, increment]
  recurring_entry_id integer                     [not null, ref: > recurring_entries.id, note: 'ON DELETE CASCADE']
  due_on             date                        [not null]
  amount             integer                     [not null, note: 'CHECK amount > 0；產生時的金額快照']
  status             recurring_occurrence_status [not null, default: 'pending']
  transaction_id     integer                     [null, ref: > transactions.id, note: 'ON DELETE SET NULL；confirmed 時寫入']
  notified_at        timestamp                   [null, note: 'LINE push 成功時間；null = 尚未通知']
  resolved_at        timestamp                   [null]
  created_at         timestamp                   [not null, default: `now()`]

  indexes {
    (recurring_entry_id, due_on) [unique]
    (status, due_on)
  }

  Note: '''
  固定收支的某一期。只在 status = pending 時可確認（寫入 transactions，日期 = due_on）或略過；併發只會成功一次。
  LINE 按鈕：action=rconfirm&id=、action=rskip&id=；LIFF：/recurring/occurrences/{id}。
  '''
}
