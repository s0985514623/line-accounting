{
  "name": "line-accounting",
  "version": "0.1.0",
  "private": true,
  "description": "LINE 記帳：LINE Bot + LIFF 單一使用者記帳服務",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run tests/unit tests/http tests/db",
    "test:bdd": "cucumber-js",
    "test:bdd:dry": "cucumber-js --dry-run",
    "test:web": "npm --prefix web test",
    "smoke:image": "node scripts/smoke/image-smoke.mjs",
    "test": "npm run test:unit && npm run test:bdd && npm run test:web",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "seed:defaults": "tsx src/cli/seed-defaults.ts",
    "seed:defaults:prod": "node dist/cli/seed-defaults.js",
    "richmenu:setup": "tsx src/cli/setup-rich-menu.ts"
  },
  "dependencies": {
    "@line/bot-sdk": "11.4.0",
    "@prisma/client": "6.19.3",
    "express": "4.22.3",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "6.19.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "10.9.0",
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "4.17.25",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  }
}
