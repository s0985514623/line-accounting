# =============================================================================
# LINE 記帳 — 執行期環境變數範本（deployment-runbook §5.1）
#
# 用法：複製為 .env 後填值（.env 不進版控）。正式環境的 .env 只放在 VPS
#       /opt/my-services/apps/accounting/.env（owner deploy:deploy，權限 600）。
# 全部 key 皆由 src/config/env.ts 驗證；缺漏或格式錯誤時啟動失敗（exit 1），
# 錯誤訊息只列 key 名稱、不印值。
#
# 重要（R2）：Messaging API channel 與 LINE Login channel 必須建在「同一個 Provider」，
#             否則 webhook 的 userId 與 LIFF ID token 的 sub 不同，白名單會對不上。
# =============================================================================

# ---- 執行環境 ----------------------------------------------------------------
# development | test | production（預設 production）
NODE_ENV=development
# HTTP 監聽埠（預設 3000）
PORT=3000
# fatal | error | warn | info | debug | trace | silent（預設 info）
LOG_LEVEL=info

# 對外網址（不含結尾斜線），用於產生 LIFF 圖表連結等。必須為 http(s) URL。
# 例：https://ledger.example.com
APP_BASE_URL=

# ---- 資料庫 -------------------------------------------------------------------
# 格式：postgresql://<user>:<url-encoded-password>@<host>:<port>/<database>?schema=public&connection_limit=5
#   - 密碼含特殊字元（@ / : % 等）時必須 URL 編碼，例如 @ → %40
#   - 正式環境 host 為共用 PostgreSQL 的 service 名稱；connection_limit=5 限制本 app 連線數
#     例：postgresql://accounting:<url-encoded-pw>@postgres:5432/accounting?schema=public&connection_limit=5
#   - 本機開發（docker-compose.dev.yml）：
#       postgresql://test:test@localhost:5434/line_accounting_dev?schema=public
#     （本機以 DEV_DB_PORT=5434 啟動；若改用其他埠號，請同步調整）
DATABASE_URL=

# ---- LINE Messaging API channel（LINE Developers console → Provider → Messaging API channel）----
# Basic settings 分頁 →「Channel secret」（webhook 簽章驗證用）
LINE_CHANNEL_SECRET=
# Messaging API 分頁 →「Channel access token (long-lived)」→ Issue 發行（Reply API 用）
LINE_CHANNEL_ACCESS_TOKEN=
# 白名單：唯一可使用本服務的 LINE userId。
# Basic settings 分頁最下方 →「Your user ID」（格式：U + 32 碼小寫十六進位）
LINE_OWNER_USER_ID=

# ---- LINE Login channel（同一 Provider → LINE Login channel；LIFF app 隸屬於此 channel）----
# Basic settings 分頁 →「Channel ID」（驗證 LIFF ID token 的 client_id；不是 Messaging API 的 channel ID）
LINE_LOGIN_CHANNEL_ID=
# LIFF 分頁 → 建立的 LIFF app 之「LIFF ID」（格式如 1234567890-AbCdEfGh；Scope 必須含 openid）
LIFF_ID=
